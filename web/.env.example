# MongoDB (local, Docker, or a MongoDB Atlas mongodb+srv://... URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=job_hunter

# Scraper service. SCRAPER_TOKEN must match SERVICE_TOKEN in scraper/.env
SCRAPER_URL=http://localhost:8000
SCRAPER_TOKEN=

# Hours between automatic scrapes. Set to 0 on serverless hosts (Vercel) and use CRON_SECRET instead.
SCRAPE_INTERVAL_HOURS=6

# Login. When APP_PASSWORD is set, the whole app requires HTTP Basic auth. Always set it when deployed.
APP_USERNAME=me
APP_PASSWORD=

# Optional: lets an external cron call POST /api/scrape/run-all with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
